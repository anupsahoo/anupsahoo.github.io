---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="AI Landscape - Anup Sahoo" currentPage="ai-landscape">
  <header style="text-align:center;margin-bottom:60px;">
    <h1 style="font-size:48px;font-weight:bold;margin-bottom:20px;">AI Landscape</h1>
    <p style="font-size:20px;color:#cbd5e1;max-width:600px;margin:0 auto;line-height:1.6;">
      Comprehensive mapping of AI technologies, vendors, and solutions for enterprise decision-making.
    </p>
  </header>

  <section style="margin-bottom:60px;">
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;">Technology Categories</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:24px;">
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:20px;font-weight:600;margin-bottom:16px;color:#60a5fa;">Machine Learning Platforms</h3>
        <ul style="color:#cbd5e1;line-height:1.6;list-style:none;padding:0;">
          <li style="margin-bottom:8px;">• TensorFlow, PyTorch</li>
          <li style="margin-bottom:8px;">• Scikit-learn, XGBoost</li>
          <li style="margin-bottom:8px;">• MLflow, Kubeflow</li>
          <li style="margin-bottom:8px;">• Amazon SageMaker</li>
        </ul>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:20px;font-weight:600;margin-bottom:16px;color:#60a5fa;">Large Language Models</h3>
        <ul style="color:#cbd5e1;line-height:1.6;list-style:none;padding:0;">
          <li style="margin-bottom:8px;">• GPT-4, Claude 3</li>
          <li style="margin-bottom:8px;">• Llama 3, Mistral</li>
          <li style="margin-bottom:8px;">• Gemini, PaLM</li>
          <li style="margin-bottom:8px;">• Open Source Models</li>
        </ul>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:20px;font-weight:600;margin-bottom:16px;color:#60a5fa;">Computer Vision</h3>
        <ul style="color:#cbd5e1;line-height:1.6;list-style:none;padding:0;">
          <li style="margin-bottom:8px;">• OpenCV, MediaPipe</li>
          <li style="margin-bottom:8px;">• YOLO, R-CNN</li>
          <li style="margin-bottom:8px;">• Vision Transformers</li>
          <li style="margin-bottom:8px;">• Cloud Vision APIs</li>
        </ul>
      </div>
    </div>
  </section>

  <section style="margin-bottom:60px;">
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;">Enterprise Considerations</h2>
    <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:32px;">
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(250px, 1fr));gap:32px;">
        <div>
          <h3 style="font-size:18px;font-weight:600;margin-bottom:16px;color:#60a5fa;">Scalability</h3>
          <p style="color:#cbd5e1;line-height:1.6;">
            Consider infrastructure requirements, data processing capabilities, and model serving at scale.
          </p>
        </div>
        <div>
          <h3 style="font-size:18px;font-weight:600;margin-bottom:16px;color:#60a5fa;">Security & Compliance</h3>
          <p style="color:#cbd5e1;line-height:1.6;">
            Data privacy, model security, regulatory compliance (GDPR, HIPAA, SOC 2).
          </p>
        </div>
        <div>
          <h3 style="font-size:18px;font-weight:600;margin-bottom:16px;color:#60a5fa;">Cost Management</h3>
          <p style="color:#cbd5e1;line-height:1.6;">
            Training costs, inference costs, maintenance overhead, and ROI calculations.
          </p>
        </div>
        <div>
          <h3 style="font-size:18px;font-weight:600;margin-bottom:16px;color:#60a5fa;">Integration</h3>
          <p style="color:#cbd5e1;line-height:1.6;">
            API compatibility, existing system integration, and workflow automation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;">Vendor Landscape</h2>
    <p style="color:#cbd5e1;font-size:18px;line-height:1.6;margin-bottom:20px;">
      Detailed vendor comparisons, implementation guides, and decision matrices coming soon.
    </p>
    <div style="background:#1f2937;border-left:4px solid #60a5fa;padding:16px;margin:20px 0;">
      <p style="color:#cbd5e1;margin:0;">
        <strong>Coming Soon:</strong> Interactive vendor comparison tool with filtering by industry, use case, and technical requirements.
      </p>
    </div>
  </section>
</BaseLayout>