---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="AI Landscape - Anup Sahoo">
  <header style="text-align:center;margin-bottom:60px;">
    <h1 style="font-size:48px;font-weight:bold;margin-bottom:20px;">AI Landscape</h1>
    <p style="font-size:20px;color:#cbd5e1;max-width:600px;margin:0 auto;line-height:1.6;">
      Comprehensive mapping of AI technologies, vendors, and solutions for enterprise decision-making.
    </p>
  </header>

  <section style="margin-bottom:60px;">
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;">Technology Categories</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:24px;">
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:20px;font-weight:600;margin-bottom:16px;color:#60a5fa;">Machine Learning Platforms</h3>
        <p style="color:#cbd5e1;line-height:1.6;">TensorFlow, PyTorch, Scikit-learn, XGBoost, MLflow, Kubeflow, Amazon SageMaker</p>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:20px;font-weight:600;margin-bottom:16px;color:#60a5fa;">Large Language Models</h3>
        <p style="color:#cbd5e1;line-height:1.6;">GPT-4, Claude, Llama 3, Mistral, Gemini, Open Source Models</p>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:20px;font-weight:600;margin-bottom:16px;color:#60a5fa;">Computer Vision</h3>
        <p style="color:#cbd5e1;line-height:1.6;">OpenCV, MediaPipe, YOLO, Vision Transformers, Cloud Vision APIs</p>
      </div>
    </div>
  </section>

  <section>
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;">Enterprise Considerations</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(250px, 1fr));gap:24px;">
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:18px;font-weight:600;margin-bottom:12px;color:#60a5fa;">Scalability</h3>
        <p style="color:#cbd5e1;line-height:1.6;">Infrastructure requirements, data processing, and model serving at scale.</p>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:18px;font-weight:600;margin-bottom:12px;color:#60a5fa;">Security & Compliance</h3>
        <p style="color:#cbd5e1;line-height:1.6;">Data privacy, model security, GDPR, HIPAA, SOC 2.</p>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:18px;font-weight:600;margin-bottom:12px;color:#60a5fa;">Cost Management</h3>
        <p style="color:#cbd5e1;line-height:1.6;">Training costs, inference costs, maintenance, and ROI.</p>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:18px;font-weight:600;margin-bottom:12px;color:#60a5fa;">Integration</h3>
        <p style="color:#cbd5e1;line-height:1.6;">API compatibility, existing systems, and workflow automation.</p>
      </div>
    </div>
  </section>
</BaseLayout>