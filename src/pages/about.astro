---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About - Anup Sahoo">
  <header style="text-align:center;margin-bottom:60px;">
    <h1 style="font-size:48px;font-weight:bold;margin-bottom:20px;">About</h1>
    <p style="font-size:20px;color:#cbd5e1;max-width:600px;margin:0 auto;line-height:1.6;">
      Enterprise AI architect helping organizations build scalable, responsible AI systems.
    </p>
  </header>

  <section style="max-width:800px;margin:0 auto 60px;">
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:20px;color:#60a5fa;">My Journey</h2>
    <p style="color:#cbd5e1;line-height:1.8;margin-bottom:20px;font-size:18px;">
      I'm a technology leader with over 15 years of experience building enterprise-scale systems.
      My journey has taken me from traditional software architecture to the cutting edge of AI and machine learning.
    </p>
    <p style="color:#cbd5e1;line-height:1.8;margin-bottom:20px;font-size:18px;">
      This platform is my way of sharing the insights, patterns, and playbooks I've developed
      along the way. My goal is to help other engineers and leaders accelerate their AI journey
      while avoiding common pitfalls.
    </p>
  </section>

  <section style="margin-bottom:60px;">
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;text-align:center;">Areas of Expertise</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:24px;">
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:20px;font-weight:600;margin-bottom:12px;color:#60a5fa;">AI Architecture</h3>
        <p style="color:#cbd5e1;line-height:1.6;">Designing scalable AI systems using modern architectural patterns.</p>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:20px;font-weight:600;margin-bottom:12px;color:#60a5fa;">MLOps Engineering</h3>
        <p style="color:#cbd5e1;line-height:1.6;">Building robust ML pipelines and automated model deployment systems.</p>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:20px;font-weight:600;margin-bottom:12px;color:#60a5fa;">AI Governance</h3>
        <p style="color:#cbd5e1;line-height:1.6;">Implementing responsible AI practices and compliance frameworks.</p>
      </div>
    </div>
  </section>

  <section>
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;text-align:center;">Let's Connect</h2>
    <div style="text-align:center;">
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="https://github.com/anupsahoo" target="_blank" rel="noopener noreferrer" style="background:#2563eb;padding:12px 24px;border-radius:8px;color:white;text-decoration:none;font-weight:500;">GitHub</a>
        <a href="https://linkedin.com/in/anupsahoo" target="_blank" rel="noopener noreferrer" style="background:#2563eb;padding:12px 24px;border-radius:8px;color:white;text-decoration:none;font-weight:500;">LinkedIn</a>
      </div>
    </div>
  </section>
</BaseLayout>