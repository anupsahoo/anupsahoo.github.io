  (function () {
    const script = document.currentScript.dataset.script;
    let ready = null;
    function load() {
      if (ready) return ready;
      ready = new Promise((ok, bad) => {
        const s = document.createElement("script");
        s.src = "https://cdn.jsdelivr.net/pyodide/v0.26.4/full/pyodide.js";
        s.onload = async () => {
          const py = await loadPyodide();
          const files = JSON.parse(document.getElementById("tl-files").textContent);
          py.FS.mkdirTree("/tl"); py.FS.chdir("/tl");
          for (const [name, text] of Object.entries(files)) py.FS.writeFile("/tl/" + name, text);
          ok(py);
        };
        s.onerror = bad; document.head.appendChild(s);
      });
      return ready;
    }
    document.querySelectorAll(".tl-run button").forEach(btn => btn.addEventListener("click", async () => {
      const box = btn.parentElement, out = box.querySelector(".tl-out");
      out.hidden = false; btn.disabled = true;
      out.textContent = "Loading Python in your browser. The first run takes a few seconds.";
      try {
        const py = await load();
        out.textContent = "Running...";
        const args = JSON.stringify([script].concat(box.dataset.args ? box.dataset.args.split(" ") : []));
        const res = py.runPython(`
import io, sys, runpy, contextlib
buf = io.StringIO()
sys.argv = ${args}
code = 0
with contextlib.redirect_stdout(buf):
    try:
        runpy.run_path("/tl/attack.py", run_name="__main__")
    except SystemExit as e:
        code = e.code or 0
buf.getvalue()`);
        out.textContent = res;
      } catch (e) { out.textContent = "Could not run here: " + e; }
      btn.disabled = false;
    }));
  })();
