  .tl-run button:disabled { opacity: .6; }
  .tl-run > code { font-size: .8rem; color: #6b7280; }
  .tl-out { width: 100%; background: #1e1e1e; color: #e6e6e6; padding: 1rem; border-radius: 8px; font-size: .8rem; line-height: 1.45; white-space: pre; overflow-x: auto; margin: 0; }
</style>
