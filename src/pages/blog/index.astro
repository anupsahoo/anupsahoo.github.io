---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => {
  return data.pubDate <= new Date();
});
const sortedPosts = posts.sort((a, b) => 
  new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
---

<BaseLayout title="Blog - Anup Sahoo" currentPage="blog">
  <header style="text-align:center;margin-bottom:60px;">
    <h1 style="font-size:48px;font-weight:bold;margin-bottom:20px;">Blog</h1>
    <p style="font-size:20px;color:#cbd5e1;max-width:600px;margin:0 auto;line-height:1.6;">
      Thoughts on AI architecture, enterprise implementation, and emerging technologies.
    </p>
  </header>

  <div style="max-width:800px;margin:0 auto;">
    {sortedPosts.map((post) => (
      <BlogCard
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        author={post.data.author}
        slug={post.slug}
        tags={post.data.tags}
      />
    ))}
  </div>
</BaseLayout>
