---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Blog - Anup Sahoo">
  <h1 style="font-size:42px;font-weight:bold;margin-bottom:10px;">Blog</h1>
  <p style="color:#cbd5e1;margin-bottom:40px;">Insights on AI architecture, implementation, and enterprise strategy.</p>

  <div style="display:grid;gap:24px;">
    {posts.map((post) => (
      <a href={`/blog/${post.slug}`} style="display:block;background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;text-decoration:none;color:inherit;">
        <h2 style="font-size:22px;font-weight:600;margin-bottom:8px;color:#60a5fa;">{post.data.title}</h2>
        <p style="color:#94a3b8;font-size:14px;margin-bottom:8px;">
          {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          {post.data.author && ` · ${post.data.author}`}
        </p>
        <p style="color:#cbd5e1;line-height:1.6;">{post.data.description}</p>
        {post.data.tags && (
          <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">
            {post.data.tags.map((tag: string) => (
              <span style="background:#334155;padding:4px 10px;border-radius:4px;font-size:12px;color:#94a3b8;">{tag}</span>
            ))}
          </div>
        )}
      </a>
    ))}
  </div>
</BaseLayout>
