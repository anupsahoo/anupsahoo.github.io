---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props;
const { Content, headings } = await post.render();
---

<BaseLayout title={`${post.data.title} - Anup Sahoo`}>
  <article style="max-width:800px;margin:0 auto;">
    <header style="margin-bottom:32px;">
      <h1 style="font-size:40px;font-weight:bold;margin-bottom:12px;">{post.data.title}</h1>
      <p style="color:#94a3b8;font-size:14px;">
        {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        {post.data.author && ` · ${post.data.author}`}
      </p>
      {post.data.tags && (
        <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;">
          {post.data.tags.map((tag: string) => (
            <span style="background:#334155;padding:4px 10px;border-radius:4px;font-size:12px;color:#94a3b8;">{tag}</span>
          ))}
        </div>
      )}
    </header>

    {headings.length > 0 && (
      <nav style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:20px;margin-bottom:32px;">
        <h2 style="font-size:16px;font-weight:600;margin-bottom:12px;color:#60a5fa;">Table of Contents</h2>
        <ul style="list-style:none;padding:0;">
          {headings.map((h) => (
            <li style={`padding-left:${(h.depth - 1) * 16}px;margin-bottom:6px;`}>
              <a href={`#${h.slug}`} style="color:#cbd5e1;text-decoration:none;font-size:14px;">{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="prose">
      <Content />
    </div>

    <div style="margin-top:48px;padding-top:24px;border-top:1px solid #334155;">
      <a href="/blog" style="color:#60a5fa;text-decoration:none;">← Back to all posts</a>
    </div>
  </article>
</BaseLayout>

<style is:global>
  .prose h1, .prose h2, .prose h3, .prose h4 { color: #e2e8f0; margin-top: 32px; margin-bottom: 16px; }
  .prose h2 { font-size: 28px; font-weight: 700; }
  .prose h3 { font-size: 22px; font-weight: 600; }
  .prose p { color: #cbd5e1; line-height: 1.8; margin-bottom: 16px; }
  .prose ul, .prose ol { color: #cbd5e1; line-height: 1.8; padding-left: 24px; margin-bottom: 16px; }
  .prose li { margin-bottom: 8px; }
  .prose code { background: #1e293b; padding: 2px 6px; border-radius: 4px; font-size: 14px; }
  .prose pre { background: #1e293b; padding: 16px; border-radius: 8px; overflow-x: auto; margin-bottom: 16px; }
  .prose pre code { background: none; padding: 0; }
  .prose a { color: #60a5fa; text-decoration: underline; }
  .prose strong { color: #e2e8f0; }
  .prose blockquote { border-left: 4px solid #60a5fa; padding-left: 16px; color: #94a3b8; margin: 16px 0; }
</style>
