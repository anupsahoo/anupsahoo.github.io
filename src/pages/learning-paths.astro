---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubscribeModule from "../components/SubscribeModule.astro";
import allArticles from "../data/article-index.json";

const lpArticles = allArticles
  .filter(a => a.section === "learning-paths")
  .map(a => ({
    href: a.href,
    title: a.title,
    desc: a.description,
    date: a.publishDate.split("-")[0],
    readTime: a.readTime,
    tags: a.tags,
  }));

const tracks = [
  {
    level: "Beginner",
    color: "",
    borderColor: "border-green-600/20",
    tagColor: "bg-green-50 text-green-700 border-green-200",
    description: "Build a solid foundation in AI/ML concepts, tooling, and basic implementation patterns.",
    modules: [
      { title: "AI Fundamentals", desc: "Core concepts: supervised/unsupervised learning, neural networks, training loops, loss functions." },
      { title: "Python for ML", desc: "NumPy, Pandas, data manipulation, visualization with Matplotlib/Seaborn." },
      { title: "ML Foundations", desc: "Linear regression, classification, decision trees, model evaluation basics." },
      { title: "Introduction to LLMs", desc: "What transformers are, tokenization, prompting basics, API usage patterns." },
      { title: "Prompt Engineering 101", desc: "Zero-shot, few-shot, chain-of-thought, structured output, and prompt templates." },
    ],
  },
  {
    level: "Intermediate",
    color: "",
    borderColor: "border-blue-600/20",
    tagColor: "bg-blue-50 text-blue-700 border-blue-200",
    description: "Move from concepts to production — build real systems, pipelines, and deployable AI applications.",
    modules: [
      { title: "RAG Systems", desc: "Embedding models, vector databases, retrieval strategies, chunking, and hybrid search." },
      { title: "Fine-tuning & Adaptation", desc: "LoRA, QLoRA, PEFT methods, dataset preparation, and evaluation." },
      { title: "MLOps Foundations", desc: "Experiment tracking, model registries, CI/CD for ML, and reproducibility." },
      { title: "AI Infrastructure", desc: "GPU provisioning, model serving with vLLM/TGI, containerization, and scaling." },
      { title: "Evaluation & Testing", desc: "Automated evaluation, benchmark design, regression testing, and quality gates." },
      { title: "Safety & Governance", desc: "Bias detection, content filtering, compliance frameworks, and responsible AI." },
    ],
  },
  {
    level: "Advanced / Principal",
    color: "",
    borderColor: "border-purple-600/20",
    tagColor: "bg-purple-50 text-purple-700 border-purple-200",
    description: "Lead AI strategy, design complex systems, and drive organizational AI transformation.",
    modules: [
      { title: "Agentic System Design", desc: "Multi-agent orchestration, tool use, planning architectures, memory systems. See 35+ real thinking agents in action at our Atelier Lab." },
      { title: "Platform Architecture", desc: "AI platform design, multi-tenant serving, gateway patterns, and cost optimization." },
      { title: "LLMOps at Scale", desc: "Production LLM pipelines, A/B testing, canary deployments, and observability." },
      { title: "AI Security", desc: "Prompt injection defense, model security, data poisoning, and adversarial robustness." },
      { title: "AI Productization", desc: "Product-market fit for AI, UX patterns, pricing models, and go-to-market strategy." },
      { title: "Enterprise AI Strategy", desc: "Build vs. buy decisions, vendor evaluation, team structure, and roadmap planning." },
    ],
  },
];
---

<BaseLayout title="Learning Paths — Anup Sahoo" description="Structured learning paths from beginner to principal-level AI engineering mastery.">

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border">
    <div class="absolute inset-0 bg-gradient-to-b from-accent/5 via-transparent to-transparent"></div>
    <div class="relative max-w-content mx-auto px-6 pt-20 pb-16">
      <p class="section-label mb-4">Learning Paths</p>
      <h1 class="text-display font-extrabold text-text mb-4 max-w-3xl">Structured paths to AI engineering mastery</h1>
      <p class="text-lg text-text-secondary leading-relaxed max-w-2xl">Progress from fundamentals to principal-level expertise with structured learning tracks covering the full AI engineering stack.</p>
    </div>
  </section>

  <!-- Tracks -->
  <section class="max-w-content mx-auto px-6 py-20">
    <div class="space-y-16">
      {tracks.map((track, i) => (
        <div>
          <div class="flex items-center gap-4 mb-6">
            <span class={`text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full border ${track.tagColor}`}>{track.level}</span>
            <div class="flex-1 h-px bg-border"></div>
          </div>
          <p class="text-text-secondary leading-relaxed mb-8 max-w-2xl">{track.description}</p>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {track.modules.map((mod, j) => (
              <div class={`card ${track.borderColor}`}>
                <div class="flex items-start gap-3">
                  <span class="text-xs font-mono text-text-muted mt-1">{String(j + 1).padStart(2, '0')}</span>
                  <div>
                    <h3 class="font-semibold text-text mb-1.5">{mod.title}</h3>
                    <p class="text-sm text-text-secondary leading-relaxed">{mod.desc}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Articles -->
  <section class="border-t border-border bg-surface-50">
    <div class="max-w-content mx-auto px-6 py-20">
      <p class="section-label">Learning Resources</p>
      <h2 class="text-headline font-bold text-text mb-10">In-depth learning guides</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {lpArticles.map(article => (
          <a href={article.href} class="card-interactive group">
            <div class="flex flex-wrap gap-2 mb-3">
              {article.tags.map(tag => <span class="badge">{tag}</span>)}
            </div>
            <h3 class="text-title font-semibold text-text mb-2 group-hover:text-accent-light transition-colors">{article.title}</h3>
            <p class="text-text-secondary leading-relaxed mb-4">{article.desc}</p>
            <div class="flex items-center gap-3 text-sm text-text-muted">
              <span>{article.date}</span><span>·</span><span>{article.readTime}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Atelier Lab Showcase -->
  <section class="border-t border-border">
    <div class="max-w-content mx-auto px-6 py-20">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <p class="section-label">Hands-On Learning</p>
        <h2 class="text-headline font-bold text-text mb-4">Learn by Exploring Real Thinking Agents</h2>
        <p class="text-text-secondary leading-relaxed">
          Theory is good, but seeing 35+ autonomous thinking agents in action? That's how you truly understand 
          cognitive architectures, mental models, and agentic system design.
        </p>
      </div>
      
      <div class="bg-gradient-to-br from-accent/5 to-accent/10 border border-accent/20 rounded-xl p-8 max-w-4xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
          <div>
            <h3 class="text-xl font-bold text-text mb-4">Atelier Lab: 35+ Independent Thinking Agents</h3>
            <p class="text-text-secondary leading-relaxed mb-6">
              Each agent is a complete, enterprise-grade project demonstrating sophisticated reasoning patterns. 
              From assumption breaking to second-order thinking, from bias detection to strategic analysis - 
              see how real cognitive systems work.
            </p>
            <div class="grid grid-cols-3 gap-4 mb-6">
              <div class="text-center">
                <div class="text-2xl font-bold text-accent mb-1">35+</div>
                <div class="text-xs text-text-secondary">Agents</div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-accent mb-1">12+</div>
                <div class="text-xs text-text-secondary">Mental Models</div>
              </div>
              <div class="text-center">
                <div class="text-2xl font-bold text-accent mb-1">6</div>
                <div class="text-xs text-text-secondary">Categories</div>
              </div>
            </div>
            <div class="flex flex-col sm:flex-row gap-3">
              <a href="/atelier-lab" class="btn-primary">
                Explore Agents
              </a>
              <a href="https://github.com/anupsahoo/AtelierLabs" target="_blank" class="btn-secondary">
                View Code
              </a>
            </div>
          </div>
          <div class="space-y-3">
            <div class="bg-white/50 border border-white/20 rounded-lg p-4">
              <div class="font-semibold text-text mb-1">Assumption Breaker</div>
              <div class="text-sm text-text-secondary">Identifies hidden beliefs in your strategy using first principles thinking</div>
            </div>
            <div class="bg-white/50 border border-white/20 rounded-lg p-4">
              <div class="font-semibold text-text mb-1">Second Order Thinking</div>
              <div class="text-sm text-text-secondary">Predicts ripple effects and consequences three moves ahead</div>
            </div>
            <div class="bg-white/50 border border-white/20 rounded-lg p-4">
              <div class="font-semibold text-text mb-1">Business Stress Tester</div>
              <div class="text-sm text-text-secondary">Attacks your business ideas to find weaknesses before the market does</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Subscribe -->
  <section class="max-w-content mx-auto px-6 pb-20">
    <SubscribeModule variant="full" />
  </section>

</BaseLayout>
