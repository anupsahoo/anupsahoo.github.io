---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Newsletter - Anup Sahoo" currentPage="newsletter">
  <header style="text-align:center;margin-bottom:60px;">
    <h1 style="font-size:48px;font-weight:bold;margin-bottom:20px;">Newsletter</h1>
    <p style="font-size:20px;color:#cbd5e1;max-width:600px;margin:0 auto;line-height:1.6;">
      Stay updated with the latest insights on AI architecture, enterprise implementation, and emerging technologies.
    </p>
  </header>

  <section style="margin-bottom:60px;">
    <div style="background:#1e293b;border:1px solid #334155;border-radius:12px;padding:40px;text-align:center;max-width:600px;margin:0 auto;">
      <h2 style="font-size:28px;font-weight:bold;margin-bottom:20px;color:#60a5fa;">Subscribe to AI Insights</h2>
      <p style="color:#cbd5e1;line-height:1.6;margin-bottom:30px;">
        Join 1,000+ engineers and leaders getting weekly insights on enterprise AI implementation.
      </p>
      
      <div style="background:#0f172a;padding:20px;border-radius:8px;margin-bottom:20px;">
        <p style="color:#94a3b8;font-size:14px;margin-bottom:16px;">
          📧 Newsletter launching soon. Sign up to be notified first!
        </p>
        <div style="display:flex;gap:12px;flex-direction:column;align-items:center;">
          <input 
            type="email" 
            placeholder="Enter your email" 
            style="background:#1e293b;border:1px solid #334155;color:#e2e8f0;padding:12px 16px;border-radius:6px;width:100%;max-width:300px;font-size:14px;"
            disabled
          />
          <button 
            style="background:#374151;color:#94a3b8;padding:12px 24px;border-radius:6px;border:none;cursor:not-allowed;font-weight:500;"
            disabled
          >
            Coming Soon
          </button>
        </div>
      </div>
    </div>
  </section>

  <section style="margin-bottom:60px;">
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;text-align:center;">What You'll Get</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:24px;">
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <div style="font-size:24px;margin-bottom:16px;">🏗️</div>
        <h3 style="font-size:20px;font-weight:600;margin-bottom:12px;color:#60a5fa;">Architecture Deep Dives</h3>
        <p style="color:#cbd5e1;line-height:1.6;">
          Detailed analysis of enterprise AI architecture patterns and best practices.
        </p>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <div style="font-size:24px;margin-bottom:16px;">🚀</div>
        <h3 style="font-size:20px;font-weight:600;margin-bottom:12px;color:#60a5fa;">Implementation Guides</h3>
        <p style="color:#cbd5e1;line-height:1.6;">
          Step-by-step guides for deploying AI models in production environments.
        </p>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <div style="font-size:24px;margin-bottom:16px;">📊</div>
        <h3 style="font-size:20px;font-weight:600;margin-bottom:12px;color:#60a5fa;">Industry Insights</h3>
        <p style="color:#cbd5e1;line-height:1.6;">
          Analysis of emerging trends, vendor landscapes, and market developments.
        </p>
      </div>
    </div>
  </section>

  <section style="margin-bottom:60px;">
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;text-align:center;">Recent Topics</h2>
    <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:32px;">
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(250px, 1fr));gap:24px;">
        <div>
          <h4 style="font-size:16px;font-weight:600;margin-bottom:12px;color:#e2e8f0;">LLM Ops</h4>
          <ul style="color:#cbd5e1;line-height:1.6;list-style:none;padding:0;font-size:14px;">
            <li style="margin-bottom:6px;">• Fine-tuning strategies</li>
            <li style="margin-bottom:6px;">• Prompt engineering</li>
            <li style="margin-bottom:6px;">• Cost optimization</li>
            <li style="margin-bottom:6px;">• Performance monitoring</li>
          </ul>
        </div>
        <div>
          <h4 style="font-size:16px;font-weight:600;margin-bottom:12px;color:#e2e8f0;">MLOps Best Practices</h4>
          <ul style="color:#cbd5e1;line-height:1.6;list-style:none;padding:0;font-size:14px;">
            <li style="margin-bottom:6px;">• CI/CD for ML</li>
            <li style="margin-bottom:6px;">• Model versioning</li>
            <li style="margin-bottom:6px;">• Data pipelines</li>
            <li style="margin-bottom:6px;">• Experiment tracking</li>
          </ul>
        </div>
        <div>
          <h4 style="font-size:16px;font-weight:600;margin-bottom:12px;color:#e2e8f0;">Enterprise AI</h4>
          <ul style="color:#cbd5e1;line-height:1.6;list-style:none;padding:0;font-size:14px;">
            <li style="margin-bottom:6px;">• Governance frameworks</li>
            <li style="margin-bottom:6px;">• Risk management</li>
            <li style="margin-bottom:6px;">• ROI measurement</li>
            <li style="margin-bottom:6px;">• Change management</li>
          </ul>
        </div>
        <div>
          <h4 style="font-size:16px;font-weight:600;margin-bottom:12px;color:#e2e8f0;">Tech Reviews</h4>
          <ul style="color:#cbd5e1;line-height:1.6;list-style:none;padding:0;font-size:14px;">
            <li style="margin-bottom:6px;">• Tool comparisons</li>
            <li style="margin-bottom:6px;">• Platform evaluations</li>
            <li style="margin-bottom:6px;">• Vendor analysis</li>
            <li style="margin-bottom:6px;">• Technology trends</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section>
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;text-align:center;">Newsletter Schedule</h2>
    <div style="background:#1f2937;border-left:4px solid #60a5fa;padding:20px;margin:20px 0;max-width:800px;margin-left:auto;margin-right:auto;">
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:24px;text-align:center;">
        <div>
          <div style="font-size:24px;margin-bottom:8px;">📅</div>
          <h4 style="font-size:16px;font-weight:600;margin-bottom:8px;color:#e2e8f0;">Weekly</h4>
          <p style="color:#cbd5e1;font-size:14px;">Every Tuesday</p>
        </div>
        <div>
          <div style="font-size:24px;margin-bottom:8px;">📧</div>
          <h4 style="font-size:16px;font-weight:600;margin-bottom:8px;color:#e2e8f0;">Format</h4>
          <p style="color:#cbd5e1;font-size:14px;">Email + Web</p>
        </div>
        <div>
          <div style="font-size:24px;margin-bottom:8px;">📝</div>
          <h4 style="font-size:16px;font-weight:600;margin-bottom:8px;color:#e2e8f0;">Length</h4>
          <p style="color:#cbd5e1;font-size:14px;">5-7 min read</p>
        </div>
        <div>
          <div style="font-size:24px;margin-bottom:8px;">🆓</div>
          <h4 style="font-size:16px;font-weight:600;margin-bottom:8px;color:#e2e8f0;">Price</h4>
          <p style="color:#cbd5e1;font-size:14px;">Always free</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>