---
import { SUBSCRIBE_ACTION } from '../data/newsletter';
import BaseLayout from "../layouts/BaseLayout.astro";

const benefits = [
  { title: "Architecture Deep Dives", desc: "Detailed analysis of enterprise AI architecture patterns, system design decisions, and trade-offs." },
  { title: "Implementation Guides", desc: "Step by step guides for putting AI into production, covering RAG, agents, serving, and more." },
  { title: "Landscape Analysis", desc: "Curated analysis of emerging tools, frameworks, and platforms in the AI ecosystem." },
  { title: "Engineering Leadership", desc: "Insights on building AI teams, managing technical debt, and driving AI transformation." },
];
---

<BaseLayout title="Newsletter by Anup Sahoo" description="Insights on AI validation, evals, enterprise AI architecture, implementation patterns, and engineering leadership.">

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-accent/5 via-transparent to-transparent"></div>
    <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[600px] h-[600px] bg-accent/5 rounded-full blur-3xl"></div>
    <div class="relative max-w-content mx-auto px-6 pt-24 pb-20">
      <div class="max-w-2xl mx-auto text-center" data-subscribe-scope>
        <p class="section-label mb-4">Newsletter</p>
        <h1 class="text-display font-extrabold text-text mb-6">Stay ahead in<br/><span class="gradient-text">AI engineering</span></h1>
        <p class="text-lg text-text-secondary leading-relaxed mb-10">Practical writing on agent validation, evals, and enterprise AI architecture. No fluff, just what I've learned shipping real systems.</p>
        <form data-subscribe-form data-subscribe-view class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" action={SUBSCRIBE_ACTION} method="post" target="_blank">
          <input type="hidden" name="embed" value="1" />
          <input type="email" name="email" placeholder="your@email.com" required class="flex-1 px-4 py-3.5 bg-white border border-border rounded-lg text-text placeholder:text-text-muted focus:outline-none focus:border-accent/50 focus:ring-1 focus:ring-accent/20 transition-all text-center sm:text-left" />
          <button type="submit" class="btn-primary whitespace-nowrap !py-3.5">Subscribe</button>
        </form>
        <p data-subscribe-success class="hidden max-w-md mx-auto rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800">You're subscribed! You'll get an email whenever a new post goes live.</p>
        <p class="text-xs text-text-muted mt-4">No spam. Unsubscribe anytime. Your email is never shared.</p>
      </div>
    </div>
    <div class="divider-line"></div>
  </section>

  <!-- What You'll Get -->
  <section class="max-w-content mx-auto px-6 py-20">
    <div class="text-center mb-12">
      <p class="section-label">What You'll Get</p>
      <h2 class="text-headline font-bold text-text">Curated AI engineering knowledge</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto">
      {benefits.map(b => (
        <div class="card">
          <h3 class="text-lg font-semibold text-text mb-2">{b.title}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{b.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Frequency -->
  <section class="border-t border-border bg-surface-50">
    <div class="max-w-content mx-auto px-6 py-20">
      <div class="max-w-2xl mx-auto text-center">
        <p class="section-label">Cadence</p>
        <h2 class="text-headline font-bold text-text mb-4">Four pieces a month</h2>
        <p class="text-text-secondary leading-relaxed">Every time a new piece goes live, it lands in your inbox. Each one goes deep on a single topic instead of being a list of links. You'll get clear analysis, working code, and ideas you can use the same week.</p>
      </div>
    </div>
  </section>

</BaseLayout>