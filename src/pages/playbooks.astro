---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Playbooks - Anup Sahoo" currentPage="playbooks">
  <header style="text-align:center;margin-bottom:60px;">
    <h1 style="font-size:48px;font-weight:bold;margin-bottom:20px;">Playbooks</h1>
    <p style="font-size:20px;color:#cbd5e1;max-width:600px;margin:0 auto;line-height:1.6;">
      Step-by-step guides for AI implementation, governance, and operational excellence.
    </p>
  </header>

  <section style="margin-bottom:60px;">
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;">Implementation Playbooks</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(350px, 1fr));gap:24px;">
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:20px;font-weight:600;margin-bottom:16px;color:#60a5fa;">LLM Implementation</h3>
        <p style="color:#cbd5e1;line-height:1.6;margin-bottom:16px;">
          Complete guide to deploying large language models in production.
        </p>
        <ol style="color:#94a3b8;line-height:1.6;padding-left:20px;font-size:14px;">
          <li style="margin-bottom:8px;">Model selection and evaluation</li>
          <li style="margin-bottom:8px;">Infrastructure provisioning</li>
          <li style="margin-bottom:8px;">Fine-tuning strategies</li>
          <li style="margin-bottom:8px;">Prompt engineering</li>
          <li style="margin-bottom:8px;">Monitoring and optimization</li>
        </ol>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:20px;font-weight:600;margin-bottom:16px;color:#60a5fa;">Computer Vision Deployment</h3>
        <p style="color:#cbd5e1;line-height:1.6;margin-bottom:16px;">
          End-to-end deployment of computer vision models at scale.
        </p>
        <ol style="color:#94a3b8;line-height:1.6;padding-left:20px;font-size:14px;">
          <li style="margin-bottom:8px;">Data pipeline setup</li>
          <li style="margin-bottom:8px;">Model training and validation</li>
          <li style="margin-bottom:8px;">Edge deployment optimization</li>
          <li style="margin-bottom:8px;">Real-time inference setup</li>
          <li style="margin-bottom:8px;">Performance monitoring</li>
        </ol>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:20px;font-weight:600;margin-bottom:16px;color:#60a5fa;">ML Pipeline Automation</h3>
        <p style="color:#cbd5e1;line-height:1.6;margin-bottom:16px;">
          Building robust, automated machine learning pipelines.
        </p>
        <ol style="color:#94a3b8;line-height:1.6;padding-left:20px;font-size:14px;">
          <li style="margin-bottom:8px;">Data ingestion and validation</li>
          <li style="margin-bottom:8px;">Feature engineering automation</li>
          <li style="margin-bottom:8px;">Model training orchestration</li>
          <li style="margin-bottom:8px;">Deployment pipelines</li>
          <li style="margin-bottom:8px;">Continuous monitoring</li>
        </ol>
      </div>
    </div>
  </section>

  <section style="margin-bottom:60px;">
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;">Governance & Compliance</h2>
    <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:32px;">
      <h3 style="font-size:24px;font-weight:600;margin-bottom:20px;color:#60a5fa;">AI Governance Framework</h3>
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(250px, 1fr));gap:24px;">
        <div>
          <h4 style="font-size:16px;font-weight:600;margin-bottom:12px;color:#e2e8f0;">Risk Assessment</h4>
          <ul style="color:#cbd5e1;line-height:1.6;list-style:none;padding:0;font-size:14px;">
            <li style="margin-bottom:6px;">• Bias detection</li>
            <li style="margin-bottom:6px;">• Fairness metrics</li>
            <li style="margin-bottom:6px;">• Impact assessment</li>
            <li style="margin-bottom:6px;">• Risk categorization</li>
          </ul>
        </div>
        <div>
          <h4 style="font-size:16px;font-weight:600;margin-bottom:12px;color:#e2e8f0;">Compliance Management</h4>
          <ul style="color:#cbd5e1;line-height:1.6;list-style:none;padding:0;font-size:14px;">
            <li style="margin-bottom:6px;">• GDPR compliance</li>
            <li style="margin-bottom:6px;">• HIPAA requirements</li>
            <li style="margin-bottom:6px;">• Industry regulations</li>
            <li style="margin-bottom:6px;">• Audit trails</li>
          </ul>
        </div>
        <div>
          <h4 style="font-size:16px;font-weight:600;margin-bottom:12px;color:#e2e8f0;">Model Documentation</h4>
          <ul style="color:#cbd5e1;line-height:1.6;list-style:none;padding:0;font-size:14px;">
            <li style="margin-bottom:6px;">• Model cards</li>
            <li style="margin-bottom:6px;">• Data sheets</li>
            <li style="margin-bottom:6px;">• Performance reports</li>
            <li style="margin-bottom:6px;">• Version control</li>
          </ul>
        </div>
        <div>
          <h4 style="font-size:16px;font-weight:600;margin-bottom:12px;color:#e2e8f0;">Ethical Guidelines</h4>
          <ul style="color:#cbd5e1;line-height:1.6;list-style:none;padding:0;font-size:14px;">
            <li style="margin-bottom:6px;">• Transparency principles</li>
            <li style="margin-bottom:6px;">• Accountability frameworks</li>
            <li style="margin-bottom:6px;">• Human oversight</li>
            <li style="margin-bottom:6px;">• Stakeholder engagement</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section style="margin-bottom:60px;">
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;">Operational Excellence</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:24px;">
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:18px;font-weight:600;margin-bottom:12px;color:#60a5fa;">Monitoring & Observability</h3>
        <div style="background:#0f172a;padding:12px;border-radius:4px;font-family:monospace;font-size:12px;color:#e2e8f0;margin-bottom:12px;">
          Metrics → Alerts → Dashboards → Actions
        </div>
        <ul style="color:#cbd5e1;line-height:1.6;list-style:none;padding:0;font-size:14px;">
          <li style="margin-bottom:6px;">• Model performance tracking</li>
          <li style="margin-bottom:6px;">• Data drift detection</li>
          <li style="margin-bottom:6px;">• System health monitoring</li>
          <li style="margin-bottom:6px;">• User experience metrics</li>
        </ul>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:18px;font-weight:600;margin-bottom:12px;color:#60a5fa;">Incident Response</h3>
        <div style="background:#0f172a;padding:12px;border-radius:4px;font-family:monospace;font-size:12px;color:#e2e8f0;margin-bottom:12px;">
          Detection → Analysis → Response → Recovery
        </div>
        <ul style="color:#cbd5e1;line-height:1.6;list-style:none;padding:0;font-size:14px;">
          <li style="margin-bottom:6px;">• Incident classification</li>
          <li style="margin-bottom:6px;">• Escalation procedures</li>
          <li style="margin-bottom:6px;">• Rollback strategies</li>
          <li style="margin-bottom:6px;">• Post-incident reviews</li>
        </ul>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:18px;font-weight:600;margin-bottom:12px;color:#60a5fa;">Continuous Improvement</h3>
        <div style="background:#0f172a;padding:12px;border-radius:4px;font-family:monospace;font-size:12px;color:#e2e8f0;margin-bottom:12px;">
          Collect → Analyze → Improve → Validate
        </div>
        <ul style="color:#cbd5e1;line-height:1.6;list-style:none;padding:0;font-size:14px;">
          <li style="margin-bottom:6px;">• Feedback loops</li>
          <li style="margin-bottom:6px;">• A/B testing</li>
          <li style="margin-bottom:6px;">• Model retraining</li>
          <li style="margin-bottom:6px;">• Performance optimization</li>
        </ul>
      </div>
    </div>
  </section>

  <section>
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;">Quick Start Templates</h2>
    <div style="background:#1f2937;border-left:4px solid #60a5fa;padding:20px;margin:20px 0;">
      <p style="color:#cbd5e1;margin-bottom:16px;">
        <strong>Coming Soon:</strong> Downloadable templates and checklists for common AI implementation scenarios.
      </p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:16px;">
        <div style="background:#374151;padding:12px;border-radius:6px;text-align:center;">
          <span style="color:#94a3b8;font-size:14px;">📋 LLM Deployment Checklist</span>
        </div>
        <div style="background:#374151;padding:12px;border-radius:6px;text-align:center;">
          <span style="color:#94a3b8;font-size:14px;">📊 Model Evaluation Template</span>
        </div>
        <div style="background:#374151;padding:12px;border-radius:6px;text-align:center;">
          <span style="color:#94a3b8;font-size:14px;">🔒 Security Review Guide</span>
        </div>
        <div style="background:#374151;padding:12px;border-radius:6px;text-align:center;">
          <span style="color:#94a3b8;font-size:14px;">📈 ROI Calculator</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>