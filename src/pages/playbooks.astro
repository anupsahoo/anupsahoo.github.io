---
import BaseLayout from "../layouts/BaseLayout.astro";
import SubscribeModule from "../components/SubscribeModule.astro";
import allArticles from "../data/article-index.json";

const playbooks = [
  { title: "LLM Implementation", desc: "Model selection, infrastructure setup, prompt engineering, fine-tuning, and production monitoring." },
  { title: "RAG System Deployment", desc: "Document ingestion, embedding pipelines, vector store setup, retrieval tuning, and evaluation." },
  { title: "ML Pipeline Automation", desc: "Feature engineering, training orchestration, CI/CD for models, and continuous monitoring." },
  { title: "AI Governance Framework", desc: "Risk assessment, bias detection, compliance frameworks, model cards, and audit trails." },
  { title: "Model Monitoring & Ops", desc: "Performance tracking, data drift detection, alerting, incident response, and rollback strategies." },
  { title: "Cost Optimization", desc: "Infrastructure right-sizing, inference optimization, caching strategies, and budget management." },
];

const handWritten = [
  {
    href: "/playbooks/llm-evaluation-framework",
    title: "Building an LLM Evaluation Framework",
    desc: "A practical guide to evaluating LLM outputs systematically — from automated metrics to human evaluation protocols.",
    date: "2025",
    readTime: "11 min read",
    tags: ["Evaluation", "LLMs"],
  },
];

const handWrittenSlugs = new Set(handWritten.map(a => a.href));

const generated = allArticles
  .filter(a => a.section === "playbooks" && !handWrittenSlugs.has(a.href))
  .map(a => ({
    href: a.href,
    title: a.title,
    desc: a.description,
    date: a.publishDate.split("-")[0],
    readTime: a.readTime,
    tags: a.tags,
  }));

const articles = [...handWritten, ...generated];
---

<BaseLayout title="Playbooks — Anup Sahoo" description="Step-by-step implementation guides, governance frameworks, and operational playbooks for enterprise AI.">

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border">
    <div class="absolute inset-0 bg-gradient-to-b from-accent/5 via-transparent to-transparent"></div>
    <div class="relative max-w-content mx-auto px-6 pt-20 pb-16">
      <p class="section-label mb-4">Playbooks</p>
      <h1 class="text-display font-extrabold text-text mb-4 max-w-3xl">Implementation playbooks for AI teams</h1>
      <p class="text-lg text-text-secondary leading-relaxed max-w-2xl">Step-by-step guides for AI implementation, governance, and operational excellence — built from real enterprise deployments.</p>
    </div>
  </section>

  <!-- Playbook Grid -->
  <section class="max-w-content mx-auto px-6 py-20">
    <p class="section-label">Playbook Library</p>
    <h2 class="text-headline font-bold text-text mb-10">Actionable implementation guides</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {playbooks.map(p => (
        <div class="card">
          <h3 class="text-lg font-semibold text-text mb-2">{p.title}</h3>
          <p class="text-sm text-text-secondary leading-relaxed">{p.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Articles -->
  <section class="border-t border-border bg-surface-50">
    <div class="max-w-content mx-auto px-6 py-20">
      <p class="section-label">Featured Playbooks</p>
      <h2 class="text-headline font-bold text-text mb-10">In-depth implementation guides</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {articles.map(article => (
          <a href={article.href} class="card-interactive group">
            <div class="flex flex-wrap gap-2 mb-3">
              {article.tags.map(tag => <span class="badge">{tag}</span>)}
            </div>
            <h3 class="text-title font-semibold text-text mb-2 group-hover:text-accent-light transition-colors">{article.title}</h3>
            <p class="text-text-secondary leading-relaxed mb-4">{article.desc}</p>
            <div class="flex items-center gap-3 text-sm text-text-muted">
              <span>{article.date}</span><span>·</span><span>{article.readTime}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Subscribe -->
  <section class="max-w-content mx-auto px-6 py-20">
    <SubscribeModule variant="full" />
  </section>
</BaseLayout>