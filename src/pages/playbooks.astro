---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Playbooks - Anup Sahoo">
  <header style="text-align:center;margin-bottom:60px;">
    <h1 style="font-size:48px;font-weight:bold;margin-bottom:20px;">Playbooks</h1>
    <p style="font-size:20px;color:#cbd5e1;max-width:600px;margin:0 auto;line-height:1.6;">
      Step-by-step guides for AI implementation, governance, and operational excellence.
    </p>
  </header>

  <section style="margin-bottom:60px;">
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;">Implementation Guides</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:24px;">
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:20px;font-weight:600;margin-bottom:12px;color:#60a5fa;">LLM Implementation</h3>
        <p style="color:#cbd5e1;line-height:1.6;">Model selection, infrastructure, fine-tuning, prompt engineering, and monitoring.</p>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:20px;font-weight:600;margin-bottom:12px;color:#60a5fa;">Computer Vision</h3>
        <p style="color:#cbd5e1;line-height:1.6;">Data pipelines, model training, edge deployment, and real-time inference.</p>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:20px;font-weight:600;margin-bottom:12px;color:#60a5fa;">ML Pipeline Automation</h3>
        <p style="color:#cbd5e1;line-height:1.6;">Data ingestion, feature engineering, training orchestration, and continuous monitoring.</p>
      </div>
    </div>
  </section>

  <section style="margin-bottom:60px;">
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;">Governance & Compliance</h2>
    <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:32px;">
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:24px;">
        <div>
          <h4 style="font-size:16px;font-weight:600;margin-bottom:12px;color:#e2e8f0;">Risk Assessment</h4>
          <p style="color:#cbd5e1;font-size:14px;line-height:1.6;">Bias detection, fairness metrics, impact assessment.</p>
        </div>
        <div>
          <h4 style="font-size:16px;font-weight:600;margin-bottom:12px;color:#e2e8f0;">Compliance</h4>
          <p style="color:#cbd5e1;font-size:14px;line-height:1.6;">GDPR, HIPAA, industry regulations, audit trails.</p>
        </div>
        <div>
          <h4 style="font-size:16px;font-weight:600;margin-bottom:12px;color:#e2e8f0;">Documentation</h4>
          <p style="color:#cbd5e1;font-size:14px;line-height:1.6;">Model cards, data sheets, performance reports.</p>
        </div>
        <div>
          <h4 style="font-size:16px;font-weight:600;margin-bottom:12px;color:#e2e8f0;">Ethics</h4>
          <p style="color:#cbd5e1;font-size:14px;line-height:1.6;">Transparency, accountability, human oversight.</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <h2 style="font-size:32px;font-weight:bold;margin-bottom:30px;">Operational Excellence</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(300px, 1fr));gap:24px;">
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:18px;font-weight:600;margin-bottom:12px;color:#60a5fa;">Monitoring</h3>
        <p style="color:#cbd5e1;line-height:1.6;">Model performance tracking, data drift detection, system health.</p>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:18px;font-weight:600;margin-bottom:12px;color:#60a5fa;">Incident Response</h3>
        <p style="color:#cbd5e1;line-height:1.6;">Classification, escalation, rollback strategies, post-incident reviews.</p>
      </div>
      <div style="background:#1e293b;border:1px solid #334155;border-radius:8px;padding:24px;">
        <h3 style="font-size:18px;font-weight:600;margin-bottom:12px;color:#60a5fa;">Continuous Improvement</h3>
        <p style="color:#cbd5e1;line-height:1.6;">Feedback loops, A/B testing, model retraining, optimization.</p>
      </div>
    </div>
  </section>
</BaseLayout>