      },
      {
        name: "Anti-Fragility",
        description: "Makes systems stronger under stress",
        mentalModels: ["Anti-Fragility Theory", "Risk Management"],
        githubUrl: "https://github.com/anupsahoo/AtelierLabs/blob/main/strategy/anti_fragility.py"
      }
    ]
  },
  {
    id: "communication",
    title: "Communication Intelligence",
    description: "Agents that enhance communication and influence",
    icon: "",
    agents: [
      {
        name: "Ego Filter",
