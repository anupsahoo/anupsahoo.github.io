      }
    ]
  },
  {
    id: "beyond-software",
    title: "Beyond Software",
    description: "Philosophical agents for deeper thinking and legacy",
    icon: "",
    agents: [
      {
        name: "Digital Dharma",
        description: "Analyzes if work creates value or noise",
        mentalModels: ["Essentialism", "Value Theory"],
        githubUrl: "https://github.com/anupsahoo/AtelierLabs/blob/main/beyond_software/digital_dharma.py"
      },
      {
        name: "Silence Agent",
        description: "Suggests what to stop doing",
