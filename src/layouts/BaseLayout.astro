---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
}

const {
  title = "Beyond Models — by Anup Sahoo",
  description = "Enterprise AI architecture, landscape mapping, governance patterns, and implementation playbooks.",
  ogImage = "/og-default.png",
  canonicalUrl,
  noindex = false,
} = Astro.props;

const siteUrl = "https://anupsahoo.github.io";
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const fullOgImage = ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`;

const navLinks = [
  { href: "/ai-landscape", label: "AI Landscape" },
  { href: "/architecture", label: "Architecture" },
  { href: "/playbooks", label: "Playbooks" },
  { href: "/learning-paths", label: "Learning Paths" },
  { href: "/atelier-lab", label: "Atelier Lab" },
  { href: "/about", label: "About" },
];

const categories = [
  "AI Fundamentals", "ML Foundations", "LLMs", "Prompt Engineering",
  "RAG", "Agentic Systems", "Evaluation & Reliability", "Safety & Governance",
  "AI Infrastructure", "MLOps / LLMOps", "AI Testing", "Security", "Productization",
];
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />

  <!-- OpenGraph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullOgImage} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Beyond Models — by Anup Sahoo" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullOgImage} />

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title="Beyond Models RSS" href="/rss.xml" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body class="bg-surface text-text font-sans antialiased">

  <!-- Sticky Navbar -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-lg border-b border-border">
    <div class="max-w-content mx-auto px-6 h-16 flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <span class="text-lg font-bold text-text tracking-tight">Beyond Models</span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-1">
        {navLinks.map(link => (
          <a href={link.href} class="px-3 py-2 text-sm font-medium text-text-secondary hover:text-text rounded-lg hover:bg-surface-100 transition-all duration-200">{link.label}</a>
        ))}
      </div>

      <!-- Subscribe CTA -->
      <div class="flex items-center gap-3">
        <a href="/newsletter" class="btn-primary text-sm !px-4 !py-2">Subscribe</a>
        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="md:hidden p-2 text-text-secondary hover:text-text rounded-lg hover:bg-surface-200 transition-colors" aria-label="Toggle menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Nav -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-white">
      <div class="px-6 py-4 flex flex-col gap-1">
        {navLinks.map(link => (
          <a href={link.href} class="px-3 py-2.5 text-sm text-text-secondary hover:text-text rounded-lg hover:bg-surface-200 transition-colors">{link.label}</a>
        ))}
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="pt-16 min-h-screen">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-border bg-surface-50/50">
    <div class="max-w-content mx-auto px-6 py-16">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
        <!-- Brand -->
        <div class="md:col-span-1">
          <a href="/" class="inline-block mb-4">
            <span class="text-lg font-bold text-text tracking-tight">Beyond Models</span>
          </a>
          <p class="text-sm text-text-muted leading-relaxed">Enterprise AI architecture, landscape mapping, and implementation playbooks for engineering leaders.</p>
        </div>

        <!-- Platform -->
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-widest text-text-muted mb-4">Platform</h4>
          <ul class="space-y-2.5">
            {navLinks.map(link => (
              <li><a href={link.href} class="text-sm text-text-secondary hover:text-text transition-colors">{link.label}</a></li>
            ))}
          </ul>
        </div>

        <!-- Categories -->
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-widest text-text-muted mb-4">Topics</h4>
          <ul class="space-y-2.5">
            {categories.slice(0, 6).map(cat => (
              <li><span class="text-sm text-text-secondary">{cat}</span></li>
            ))}
          </ul>
        </div>

        <!-- Subscribe -->
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-widest text-text-muted mb-4">Stay Updated</h4>
          <p class="text-sm text-text-secondary mb-4">Weekly insights on enterprise AI architecture and implementation.</p>
          <a href="/newsletter" class="btn-primary text-sm w-full text-center">Subscribe to Newsletter</a>
          <div class="flex gap-4 mt-6">
            <a href="https://github.com/anupsahoo" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-text transition-colors" aria-label="GitHub">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </a>
            <a href="https://www.linkedin.com/in/sahooanup/" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-text transition-colors" aria-label="LinkedIn">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom bar -->
      <div class="divider-line mb-8"></div>
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-text-muted">
        <p>&copy; {new Date().getFullYear()} Anup Sahoo. All rights reserved.</p>
        <div class="flex gap-6">
          <a href="/rss.xml" class="hover:text-text transition-colors">RSS Feed</a>
          <a href="/sitemap-index.xml" class="hover:text-text transition-colors">Sitemap</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Mobile menu toggle -->
  <script>
    document.getElementById('mobile-menu-btn')?.addEventListener('click', () => {
      document.getElementById('mobile-menu')?.classList.toggle('hidden');
    });
  </script>
</body>
</html>
